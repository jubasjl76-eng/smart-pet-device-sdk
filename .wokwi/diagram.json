{
  "version": 1,
  "author": "smart-pet",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo1", "top": -120, "left": 200, "attrs": {} },
    { "type": "wokwi-hc-sr04", "id": "dist1", "top": 120, "left": 190, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -20, "left": -110, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 40, "left": -110, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "servo1:PWM", "esp:4", "green", [] ],
    [ "servo1:V+", "esp:5V", "red", [] ],
    [ "servo1:GND", "esp:GND.1", "black", [] ],

    [ "dist1:TRIG", "esp:5", "green", [] ],
    [ "dist1:ECHO", "esp:18", "green", [] ],
    [ "dist1:VCC", "esp:5V", "red", [] ],
    [ "dist1:GND", "esp:GND.2", "black", [] ],

    [ "esp:2", "r1:1", "green", [] ],
    [ "r1:2", "led1:A", "green", [] ],
    [ "led1:C", "esp:GND.3", "black", [] ]
  ]
}
